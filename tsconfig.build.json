{
    "compilerOptions": {
        "target": "es2020",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "noLib": false,
        "module": "commonjs",
        "paths": {"*": ["./*"]},
        "resolveJsonModule": true,
        "declaration": true,
        "sourceMap": true,
        "rootDir": "./src",
        "outDir": "./tsc-out",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames":true ,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
    },
    "include": ["src"]
}